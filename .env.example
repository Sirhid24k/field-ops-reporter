# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by lib/supabase/admin.ts (onboarding, invite completion, the pipeline).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for `npm run db:push` and `npm run db:types`.
# Project settings → Database → Connection string → Session pooler (port 5432).
# Percent-encode the password.
SUPABASE_DB_URL=

# Google AI Studio
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash
DIGEST_MODEL=gemini-3.5-flash

# Speech-to-text provider
STT_PROVIDER=
STT_API_KEY=

# Any long random string; protects /api/cron/*
CRON_SECRET=

# Public origin of the app; used for magic-link redirects and invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. DEV_TOOLS=true keeps /dev/report-status available on a production build.
# NEXT_PUBLIC_ENABLE_SW=1 registers the service worker on the dev server (it is always on in production).
DEV_TOOLS=
NEXT_PUBLIC_ENABLE_SW=
