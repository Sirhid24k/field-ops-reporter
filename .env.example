# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by lib/supabase/admin.ts (onboarding, invite completion, the pipeline).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for `npm run db:push` and `npm run db:types`.
# Project settings → Database → Connection string → Session pooler (port 5432).
# Percent-encode the password.
SUPABASE_DB_URL=

# Google AI Studio
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash
DIGEST_MODEL=gemini-3.5-flash

# Speech-to-text provider. Implemented: groq (Whisper large v3 via api.groq.com, key from console.groq.com).
STT_PROVIDER=groq
STT_API_KEY=
# Optional. Groq model for transcription (default whisper-large-v3; whisper-large-v3-turbo is faster and cheaper).
STT_MODEL=

# Any long random string; protects /api/process and /api/cron/*. Vercel sends it on cron invocations.
CRON_SECRET=
# Optional. Where the app reaches its own /api/process (default: https://$VERCEL_URL on Vercel, else NEXT_PUBLIC_APP_URL).
PIPELINE_BASE_URL=
# Optional. Set on Vercel when preview deployments have Deployment Protection, so the self-call gets through.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Public origin of the app; used for magic-link redirects and invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. DEV_TOOLS=true keeps /dev/report-status available on a production build.
# NEXT_PUBLIC_ENABLE_SW=1 registers the service worker on the dev server (it is always on in production).
DEV_TOOLS=
NEXT_PUBLIC_ENABLE_SW=
